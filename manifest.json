{
  "manifest_version": 3,
  "name": "PoeLog",
  "version": "1.3",
  "description": "Download entire AI conversation log from poe.com",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://poe.com/*",
        "https://www.poe.com/*"
      ],
      "js": ["turndown.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page_bridge.js"],
      "matches": [
        "https://poe.com/*",
        "https://www.poe.com/*"
      ]
    }
  ]
}
